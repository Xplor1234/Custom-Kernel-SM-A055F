#
# Rissu's Custom Configurations
# For Galaxy A05 and A04
#
CONFIG_LOCALVERSION="-TragicHorizon-v1.r1-OneUI-7.0"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_SAMSUNG_LMKD_DEBUG=n
CONFIG_USB_DEBUG_DETAILED_LOG=n
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_SECURITY_AVC_STATS=n
CONFIG_MTPROF=n
CONFIG_NL80211_TESTMODE=n
CONFIG_SND_DEBUG=n
CONFIG_SND_DEBUG_VERBOSE=n
CONFIG_SND_VERBOSE_PRINTK=n
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=n
CONFIG_TCP_CONG_WESTWOOD=n
CONFIG_TCP_CONG_HTCP=n
CONFIG_SND_SOC_MT6357_ACCDET=n
CONFIG_SND_SOC_MT6359_ACCDET=n
CONFIG_MMSTAT_TRACER=n
CONFIG_IKHEADERS=n
CONFIG_KPROBES=n
CONFIG_KSU=y
CONFIG_KSU_CMDLINE=y
CONFIG_KALLSYMS_ALL=n
CONFIG_ZRAM_DEFAULT_COMP_ALGORITHM="lz4"
CONFIG_DISABLE_TRACE_PRINTK=y
CONFIG_ARM64_SVE=n
CONFIG_REFCOUNT_FULL=n

